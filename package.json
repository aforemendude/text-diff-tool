{
  "dependencies": {
    "@aforemendude/prettier-plugin-wrap-comments": "1.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "prettier": "3.9.6",
    "prettier-plugin-jsdoc": "1.8.1",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "name": "text-diff-tool",
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "deploy": "npm install && git diff --exit-code -- package-lock.json && npm run verify",
    "dev": "vite",
    "format": "prettier --write --cache --cache-strategy metadata .",
    "format:check": "prettier --check --cache --cache-strategy metadata .",
    "format:nocache": "prettier --write .",
    "integration": "npm run build && playwright test",
    "integration:dev": "playwright test",
    "playwright:install": "playwright install",
    "playwright:install-deps": "playwright install-deps",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "prettier --check . && npm run test && npm run integration"
  },
  "type": "module",
  "version": "1.0.0"
}
